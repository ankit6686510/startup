# Test Environment Configuration
NODE_ENV=test

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=startup_compass_test

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=15

# JWT Configuration
JWT_SECRET=test-jwt-secret-key-for-testing-only
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=test-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=7d

# API Configuration
API_PORT=3000
API_HOST=localhost

# Service URLs (for integration tests)
USER_SERVICE_URL=http://localhost:3001
JOB_SERVICE_URL=http://localhost:3002
FUNDING_SERVICE_URL=http://localhost:3003
NOTIFICATION_SERVICE_URL=http://localhost:3004
NEWS_SERVICE_URL=http://localhost:3005

# Email Configuration (test mode)
EMAIL_PROVIDER=test
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=test@example.com
SMTP_PASS=testpassword

# External API Keys (test/mock values)
EXTERNAL_NEWS_API_KEY=test-news-api-key
EXTERNAL_FUNDING_API_KEY=test-funding-api-key

# Logging Configuration
LOG_LEVEL=error
LOG_FILE=false

# Rate Limiting (relaxed for tests)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./test-uploads

# Cache Configuration
CACHE_TTL=300
CACHE_MAX_KEYS=1000

# Test-specific Configuration
TEST_TIMEOUT=30000
TEST_DB_CLEANUP=true
TEST_REDIS_CLEANUP=true