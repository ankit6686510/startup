{
  "name": "startup-compass-platform",
  "version": "1.0.0",
  "description": "A comprehensive microservices platform for startup ecosystem management",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:e2e": "jest --selectProjects e2e",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:services",
    "build:services": "npm run build:api-gateway && npm run build:user-service && npm run build:job-service && npm run build:funding-service && npm run build:notification-service",
    "build:api-gateway": "cd services/api-gateway && npm run build",
    "build:user-service": "cd services/user-service && npm run build",
    "build:job-service": "cd services/job-service && npm run build",
    "build:funding-service": "cd services/funding-service && npm run build",
    "build:notification-service": "cd services/notification-service && npm run build",
    "dev": "docker-compose up -d",
    "dev:logs": "docker-compose logs -f",
    "dev:stop": "docker-compose down",
    "dev:clean": "docker-compose down -v --remove-orphans",
    "install:all": "npm install && npm run install:services",
    "install:services": "cd services/api-gateway && npm install && cd ../user-service && npm install && cd ../job-service && npm install && cd ../funding-service && npm install && cd ../notification-service && npm install",
    "clean": "npm run clean:coverage && npm run clean:dist && npm run clean:logs",
    "clean:coverage": "rm -rf coverage",
    "clean:dist": "rm -rf services/*/dist",
    "clean:logs": "rm -rf logs",
    "health": "node scripts/health-check.js",
    "migrate": "npm run migrate:user && npm run migrate:job && npm run migrate:funding",
    "migrate:user": "cd services/user-service && npm run migrate",
    "migrate:job": "cd services/job-service && npm run migrate",
    "migrate:funding": "cd services/funding-service && npm run migrate",
    "seed": "npm run seed:user && npm run seed:job && npm run seed:funding",
    "seed:user": "cd services/user-service && npm run seed",
    "seed:job": "cd services/job-service && npm run seed",
    "seed:funding": "cd services/funding-service && npm run seed"
  },
  "keywords": [
    "startup",
    "microservices",
    "nodejs",
    "typescript",
    "docker",
    "postgresql",
    "redis",
    "api-gateway",
    "job-board",
    "funding-tracker"
  ],
  "author": "StartupCompass Team",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.5",
    "@types/node": "^20.6.0",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "eslint": "^8.49.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "prettier": "^3.0.3",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "typeorm": "^0.3.17",
    "typeorm-extension": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/startup-compass/platform.git"
  },
  "bugs": {
    "url": "https://github.com/startup-compass/platform/issues"
  },
  "homepage": "https://github.com/startup-compass/platform#readme"
}
