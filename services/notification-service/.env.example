# Server Configuration
PORT=3005
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=startup_platform_notifications

# Redis Configuration (for queues and caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@startupcompass.com
FROM_NAME=StartupCompass

# Email Service Providers
SENDGRID_API_KEY=your-sendgrid-api-key
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=your-mailgun-domain
SES_ACCESS_KEY_ID=your-ses-access-key
SES_SECRET_ACCESS_KEY=your-ses-secret-key
SES_REGION=us-east-1

# Push Notifications
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@startupcompass.com

# Firebase Cloud Messaging
FCM_SERVER_KEY=your-fcm-server-key
FCM_PROJECT_ID=your-firebase-project-id

# Apple Push Notification Service
APNS_KEY_ID=your-apns-key-id
APNS_TEAM_ID=your-apple-team-id
APNS_BUNDLE_ID=com.startupcompass.app
APNS_PRIVATE_KEY_PATH=path/to/apns-private-key.p8
APNS_PRODUCTION=false

# SMS Configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Slack Integration
SLACK_BOT_TOKEN=your-slack-bot-token
SLACK_WEBHOOK_URL=your-slack-webhook-url

# Discord Integration
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_WEBHOOK_URL=your-discord-webhook-url

# Microsoft Teams
TEAMS_WEBHOOK_URL=your-teams-webhook-url

# External Services
USER_SERVICE_URL=http://localhost:3002
STARTUP_SERVICE_URL=http://localhost:3001
JOB_SERVICE_URL=http://localhost:3003
FUNDING_SERVICE_URL=http://localhost:3004

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Queue Configuration
QUEUE_CONCURRENCY=5
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY=5000

# Notification Settings
EMAIL_BATCH_SIZE=100
PUSH_BATCH_SIZE=1000
SMS_BATCH_SIZE=50

# Template Configuration
TEMPLATE_CACHE_TTL=3600
ENABLE_TEMPLATE_CACHING=true

# Analytics and Tracking
ENABLE_DELIVERY_TRACKING=true
ENABLE_OPEN_TRACKING=true
ENABLE_CLICK_TRACKING=true

# Webhook Configuration
WEBHOOK_SECRET=your-webhook-secret
WEBHOOK_TIMEOUT=30000

# File Storage (for attachments)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=startupcompass-attachments

# Logging
LOG_LEVEL=info
LOG_FILE=logs/notification-service.log

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Security
ENCRYPT_SENSITIVE_DATA=true
ENCRYPTION_KEY=your-encryption-key-here

# Performance
CACHE_NOTIFICATIONS_TTL=86400
CACHE_TEMPLATES_TTL=3600