{
  "name": "@startup-platform/notification-service",
  "version": "1.0.0",
  "description": "Notification Service for StartupCompass platform - handles email, push notifications, and alerts",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon -r tsconfig-paths/register src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "migration:generate": "typeorm migration:generate -d src/config/database.ts",
    "migration:run": "typeorm migration:run -d src/config/database.ts",
    "migration:revert": "typeorm migration:revert -d src/config/database.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "typeorm": "^0.3.17",
    "pg": "^8.11.3",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "nodemailer": "^6.9.7",
    "handlebars": "^4.7.8",
    "node-cron": "^3.0.3",
    "axios": "^1.6.2",
    "bull": "^4.12.2",
    "redis": "^4.6.10",
    "web-push": "^3.6.6",
    "twilio": "^4.19.3",
    "@slack/web-api": "^6.10.0",
    "discord.js": "^14.14.1",
    "@startup-platform/types": "file:../../shared/types",
    "@startup-platform/config-validator": "file:../../shared/config-validator"
  },
  "devDependencies": {
    "tsconfig-paths": "^4.2.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/compression": "^1.7.5",
    "@types/nodemailer": "^6.4.14",
    "@types/handlebars": "^4.1.0",
    "@types/node-cron": "^3.0.8",
    "@types/web-push": "^3.6.3",
    "@types/node": "^20.8.0",
    "typescript": "^5.2.2",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.8",
    "supertest": "^6.3.3",
    "@types/supertest": "^2.0.16",
    "eslint": "^8.54.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}