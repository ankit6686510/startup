# Server Configuration
PORT=3004
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=startup_platform_funding

# External Services
STARTUP_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
NOTIFICATION_SERVICE_URL=http://localhost:3005

# Redis Configuration (for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Data Sources and APIs
CRUNCHBASE_API_KEY=your-crunchbase-api-key
PITCHBOOK_API_KEY=your-pitchbook-api-key
ANGELLIST_API_KEY=your-angellist-api-key

# Financial Data
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key
YAHOO_FINANCE_API_KEY=your-yahoo-finance-api-key

# Currency Conversion
EXCHANGE_RATES_API_KEY=your-exchange-rates-api-key
DEFAULT_CURRENCY=USD

# Market Data
MARKET_DATA_REFRESH_INTERVAL_HOURS=24
FUNDING_DATA_SYNC_INTERVAL_HOURS=6

# Investment Analytics
ENABLE_VALUATION_ESTIMATES=true
ENABLE_MARKET_COMPARISONS=true
ENABLE_TREND_ANALYSIS=true

# Compliance and Reporting
ENABLE_REGULATORY_REPORTING=false
SEC_FILING_WEBHOOK_URL=

# Email Notifications
ENABLE_FUNDING_ALERTS=true
INVESTOR_UPDATE_FREQUENCY=weekly

# File Storage (for documents)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=startupcompass-funding-docs

# Logging
LOG_LEVEL=info
LOG_FILE=logs/funding-service.log

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Security
ENCRYPT_SENSITIVE_DATA=true
ENCRYPTION_KEY=your-encryption-key-here

# Performance
CACHE_FUNDING_DATA_TTL=3600
CACHE_MARKET_DATA_TTL=1800